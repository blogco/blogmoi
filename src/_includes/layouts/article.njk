---
layout: layouts/base.njk
---
<article class="article">
  <header class="article-header">
    {% if categories and categories.length %}<a class="eyebrow" href="{{ ('/categories/' + (categories[0] | slugify) + '/') | url }}">{{ categories[0] }}</a>{% endif %}
    <h1>{{ title }}</h1>
    {% if description %}<p class="article-deck">{{ description }}</p>{% endif %}
    <div class="article-byline"><span>{{ author or "Blogmoi" }}</span><span aria-hidden="true">·</span><time datetime="{{ date | dateIso }}">{{ date | dateReadable }}</time><span aria-hidden="true">·</span><span>{{ content | readingTime }} phút đọc</span></div>
    {% if cover %}<figure class="article-cover"><img src="{{ cover | url }}" alt="{{ coverAlt or '' }}" fetchpriority="high" width="1440" height="900">{% if coverCaption %}<figcaption>{{ coverCaption }}</figcaption>{% endif %}</figure>{% endif %}
  </header>
  <div class="article-layout">
    <aside class="article-toc-wrap">{{ content | toc | safe }}</aside>
    <div class="prose article-content">{{ content | safe }}</div>
  </div>
  {% if tags and tags.length %}<div class="article-tags" aria-label="Thẻ bài viết">{% for tag in tags %}{% if tag != 'posts' %}<a href="{{ ('/tags/' + (tag | slugify) + '/') | url }}">#{{ tag }}</a>{% endif %}{% endfor %}</div>{% endif %}
  {% set related = collections.posts | relatedPosts(page.url, categories or []) %}
  {% if related.length %}<section class="related-section section"><div class="section-heading"><div><p class="eyebrow">Khám phá tiếp</p><h2>Bài viết liên quan</h2></div><a class="text-link" href="{{ '/archives/' | url }}">Tất cả bài viết <span aria-hidden="true">→</span></a></div><div class="article-grid">{% for post in related.slice(0, 3) %}{% include "partials/article-card.njk" %}{% endfor %}</div></section>{% endif %}
</article>
