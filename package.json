{
  "name": "blogmoi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "eleventy --pathprefix=/blogmoi/",
    "build:local": "eleventy",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('_site', {recursive:true, force:true}))\"",
    "test:dictionary": "node --test tests/dictionary-pipeline.test.mjs",
    "dictionary:extract": "node scripts/extract-dictionary.mjs",
    "dictionary:translate": "node scripts/translate-dictionary.mjs",
    "dictionary:approve": "node scripts/approve-dictionary-entry.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "gray-matter": "npm:@11ty/gray-matter@1.0.0"
  }
}
