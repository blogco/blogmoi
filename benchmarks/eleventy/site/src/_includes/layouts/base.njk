<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | Benchmark blog</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ page.url | canonical }}">
  <meta property="og:type" content="{{ 'article' if type == 'article' else 'website' }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ page.url | canonical }}">
</head>
<body>
  <header><a href="/">Benchmark blog</a></header>
  <main>{{ content | safe }}</main>
</body>
</html>
