---
layout: layouts/base.njk
pagination:
  data: collections.tags
  size: 1
  alias: group
permalink: /tags/{{ group.slug }}/index.html
eleventyComputed:
  title: "Thẻ: {{ group.name }}"
  description: "Các bài viết có thẻ {{ group.name }}."
---
<h1>{{ group.name }}</h1>
<ul>{% for post in group.posts %}<li><a href="{{ post.url }}">{{ post.data.title }}</a></li>{% endfor %}</ul>
