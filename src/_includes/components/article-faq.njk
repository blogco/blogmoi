<section class="article-panel faq-panel" aria-labelledby="article-faq-title">
  <div class="article-panel__heading"><span class="article-panel__number">03</span><h2 id="article-faq-title">Hỏi đáp thường gặp</h2></div>
  {% if faq and faq.length %}
    <div class="faq-list">
      {% for item in faq.slice(0, 5) %}
        <details class="faq-item">
          <summary><span>{{ item.question }}</span><span class="faq-item__icon" aria-hidden="true"></span></summary>
          <div class="faq-item__answer">{{ item.answer }}</div>
        </details>
      {% endfor %}
    </div>
  {% else %}
    <p class="component-empty">Chưa có câu hỏi được biên tập dựa trên nội dung bài viết.</p>
  {% endif %}
</section>
