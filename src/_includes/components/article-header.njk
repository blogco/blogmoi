{% set cover = articleCover.cover %}
{% set coverAlt = articleCover.coverAlt %}
{% set coverCaption = articleCover.coverCaption %}
{% set coverAttribution = articleCover.coverAttribution %}
<nav class="article-breadcrumbs" aria-label="Đường dẫn">
  <ol>
    <li><a href="{{ '/' | url }}">Trang chủ</a></li>
    {% for category in (categories or []) %}
      {% if loop.index <= 2 %}
        <li><a href="{{ ('/categories/' + (category | slugify) + '/') | url }}">{{ category }}</a></li>
      {% endif %}
    {% endfor %}
    <li aria-current="page">{{ title }}</li>
  </ol>
</nav>

<header class="article-hero">
  <div class="article-hero__copy">
    {% if categories and categories.length %}
      <a class="article-kicker" href="{{ ('/categories/' + (categories[0] | slugify) + '/') | url }}">{{ categories[0] }}</a>
    {% endif %}
    <h1 tabindex="-1">{{ title }}</h1>
    {% if titleKo %}<p lang="ko" class="article-deck">{{ titleKo }}</p>{% endif %}
    {% if description %}<p class="article-deck">{{ description }}</p>{% endif %}
    <div class="article-byline" aria-label="Thông tin bài viết">
      <time datetime="{{ (publishDate or date) | dateIso }}">{{ (publishDate or date) | dateReadable(resolvedSeason.timeZone) }}</time>
      <span class="byline-separator" aria-hidden="true"></span>
      {% set seasonData = resolvedSeason %}{% set seasonVariant = 'article' %}{% include "components/season-label.njk" %}
      <span class="byline-separator" aria-hidden="true"></span>
      <span>{{ author or "Blogmoi" }}</span>
      {% if categories and categories.length %}
        <span class="byline-separator" aria-hidden="true"></span>
        <a href="{{ ('/categories/' + (categories[0] | slugify) + '/') | url }}">{{ categories[0] }}</a>
      {% endif %}
      <span class="byline-separator" aria-hidden="true"></span>
      <span>{{ content | readingTime }} phút đọc</span>
    </div>
  </div>

  {% if cover %}
    <figure class="article-hero__media">
      <img src="{{ cover | url }}" alt="{{ coverAlt or '' }}" fetchpriority="high" width="1440" height="810">
      {% set safePhotographerUrl = coverAttribution.photographerUrl | safeExternalUrl %}
      {% set safePhotoUrl = coverAttribution.photoUrl | safeExternalUrl %}
      {% if coverAttribution.photographer and safePhotographerUrl and safePhotoUrl %}
        <figcaption>Photo by <a href="{{ safePhotographerUrl }}" rel="noopener noreferrer">{{ coverAttribution.photographer }}</a> on <a href="{{ safePhotoUrl }}" rel="noopener noreferrer">Unsplash</a></figcaption>
      {% elif coverCaption %}<figcaption>{{ coverCaption }}{% if safePhotoUrl %} <a href="{{ safePhotoUrl }}" rel="noopener noreferrer">Unsplash</a>{% endif %}</figcaption>{% endif %}
    </figure>
  {% else %}
    <div class="article-hero__media article-hero__media--empty" aria-hidden="true"><span>Blogmoi</span></div>
  {% endif %}
</header>
