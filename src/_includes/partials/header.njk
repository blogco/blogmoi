<a class="skip-link" href="#main-content">Đến nội dung</a>
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="{{ '/' | url }}" aria-label="Blogmoi — Trang chủ">
      <span class="brand-mark" aria-hidden="true">b.</span><span class="brand-name">blogmoi</span>
    </a>
    <nav class="primary-nav" id="primary-nav" aria-label="Điều hướng chính" data-nav hidden>
      <a href="{{ '/archives/' | url }}">Bài viết</a>
      <a href="{{ '/categories/' | url }}">Chủ đề</a>
      <a href="{{ '/tu-dien-vi-kr/' | url }}"{% if page.url == '/tu-dien-vi-kr/' %} aria-current="page"{% endif %}>Từ điển VI-KR</a>
      <a href="{{ '/yy-info/' | url }}"{% if page.url == '/yy-info/' %} aria-current="page"{% endif %}>YY info</a>
      <a href="{{ '/about/' | url }}">Về Blogmoi</a>
    </nav>
    <div class="header-actions">
      <a class="icon-link" href="{{ '/search/' | url }}" aria-label="Tìm kiếm bài viết"><span aria-hidden="true">⌕</span></a>
      <button class="theme-toggle" type="button" aria-label="Bật giao diện tối" data-theme-toggle><span aria-hidden="true">◐</span></button>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Mở điều hướng" data-menu-toggle><span aria-hidden="true">☰</span></button>
    </div>
  </div>
</header>
