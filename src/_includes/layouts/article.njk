---
layout: layouts/base.njk
---
<article class="article-page">
  {% include "components/article-header.njk" %}

  {% set content = content | withoutLegacyTopicPanels %}
  {% set articleToc = content | toc %}
  {% set relatedPosts = collections.posts | relatedPosts(page.url, categories or []) %}
  {% set topicDiscovery = collections.posts | topicSuggestions(page.url, relatedPosts, content) %}
  <div class="article-layout">
    <div class="article-main" id="article-content" data-reading-area>
      {% include "components/ai-keypoints.njk" %}
      {% include "components/article-content.njk" %}
    </div>
    {% include "components/article-sidebar.njk" %}
  </div>

  {% include "components/ExploreNextTopics.njk" %}

  {% if tags and tags.length %}
    <nav class="article-tags" aria-label="Thẻ bài viết">
      {% for tag in tags %}{% if tag != "posts" %}<a href="{{ ('/tags/' + (tag | slugify) + '/') | url }}">#{{ tag }}</a>{% endif %}{% endfor %}
    </nav>
  {% endif %}

  <div class="article-endmatter">
    {% include "components/copyright-sources.njk" %}
    {% include "components/internal-links.njk" %}
    {% include "components/article-faq.njk" %}
  </div>
</article>
