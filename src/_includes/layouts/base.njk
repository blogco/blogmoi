<!doctype html>
<html lang="{{ lang or 'vi' }}" data-theme="light">
<head>
  {% set title = seoTitle or title or site.title %}
  {% set description = seoDescription or description or site.description %}
  {% set canonicalUrl = canonical or page.url | absoluteUrl %}
  {% set socialImage = ogImage or cover or articleCover.cover or '/images/blogmoi-mark.svg' %}
  {% set ogImageUrl = socialImage | absoluteUrl %}
  {% set ogType = 'article' if type == 'article' else 'website' %}
  {% if type == 'article' %}{% set structuredData = {"@context":"https://schema.org","@type":"BlogPosting","headline":title,"description":description,"datePublished":(publishDate or date) | dateIso,"dateModified":(lastModified or publishDate or date) | dateIso,"author":{"@type":"Person","name":author or "Blogmoi"},"mainEntityOfPage":canonicalUrl,"publisher":{"@type":"Organization","name":site.title},"inLanguage":lang or "vi"} %}{% endif %}
  {% include "partials/head.njk" %}
  {% if type == 'article' %}<link rel="stylesheet" href="{{ '/css/article.css' | url }}">{% endif %}
  <link rel="stylesheet" href="{{ '/css/reading-navigation.css' | url }}">
  {% if page.url == '/tu-dien-vi-kr/' %}<link rel="stylesheet" href="{{ '/css/dictionary.css' | url }}">{% endif %}
  {% if page.url == '/chi-phi-hang-thang/' %}<link rel="stylesheet" href="{{ '/css/expense-tracker.css' | url }}">{% endif %}
  <title>{{ title }}{% if title != site.title %} · {{ site.title }}{% else %} — Góc nhìn rõ ràng{% endif %}</title>
</head>
<body>
  {% include "partials/header.njk" %}
  <main id="main-content">{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  {% include "components/reading-navigation.njk" %}
  <script src="{{ '/js/site.js' | url }}" defer></script>
  <script src="{{ '/js/reading-navigation.js' | url }}" defer></script>
  {% if page.url == '/tu-dien-vi-kr/' %}<script src="{{ '/js/dictionary.js' | url }}" type="module"></script>{% endif %}
  {% if page.url == '/search/' %}<script src="{{ '/js/search.js' | url }}" defer></script>{% endif %}
  {% if page.url == '/chi-phi-hang-thang/' %}<script type="module" src="{{ '/js/expense-tracker.js' | url }}"></script>{% endif %}
</body>
</html>
