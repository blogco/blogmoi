<section class="article-panel internal-panel" aria-labelledby="internal-links-title">
  <div class="article-panel__heading"><span class="article-panel__number">02</span><h2 id="internal-links-title">Bài viết liên quan</h2></div>
  {% if relatedPosts and relatedPosts.length %}
    <ul class="internal-links-list">
      {% for post in relatedPosts %}
        <li><a href="{{ post.url | url }}"><span>{{ (post.data.categories or ["Góc nhìn"])[0] }}</span>{% set seasonData = post.data.resolvedSeason %}{% set seasonVariant = 'related' %}{% include "components/season-label.njk" %}<strong>{{ post.data.title }}</strong><time datetime="{{ (post.data.publishDate or post.date) | dateIso }}">{{ (post.data.publishDate or post.date) | dateReadable(post.data.resolvedSeason.timeZone) }}</time></a></li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="component-empty">Không có liên kết nội bộ.</p>
  {% endif %}
</section>
